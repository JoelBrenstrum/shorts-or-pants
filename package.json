{
  "name": "shorts-or-pants",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p functions",
    "build": "pnpm typecheck && vite build",
    "test": "vitest run",
    "preview": "pnpm build && wrangler pages dev dist",
    "deploy": "pnpm build && wrangler pages deploy dist"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261106.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0",
    "wrangler": "^4.158.0"
  }
}
